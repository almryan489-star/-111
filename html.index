['ph:17','طائرة سرعتها 100 km/h بالنسبة للهواء تطير ضد رياح بسرعة 20 km/h فسرعتها بالنسبة للأرض:','80 km/h','120 km/h','100 km/h','20 km/h','100 − 20.']
);
const FAQ=[['كيف أستخدم قسم ذاكر؟','اختر مواد كل يوم في الجدول، ثم شغّل مؤقت بومودورو: 25 دقيقة تركيز و5 دقائق راحة. تكتمل الشعلة 🔥 عند إنهاء 25 دقيقة.'],['كيف يعمل قسم استعد؟','اختر الفصل ثم المادة ثم الدروس. تأتيك 20 سؤالًا عشوائيًا بلا تكرار، والأخضر صحيح والأحمر خطأ مع السبب.'],['ما فائدة الشعلة؟','تحسب عدد الأيام المتتالية التي أنهيت فيها جلسة 25 دقيقة، لتحافظ على الاستمرار.'],['كيف أحفظ جدول الحصص؟','عدّل المواد ثم اضغط حفظ، فيظهر مختصرًا في الرئيسية.'],['هل تُحفظ بياناتي؟','نعم، على جهازك نفسه، وتجدها عند عودتك.'],['متى تُضاف بقية المواد؟','سنكمل الأسئلة تدريجيًا من الكتب، والقدرات والتحصيلي قريبًا.']];
const VIEWS={home:'الرئيسية',study:'ذاكر',prac:'استعد',dev:'طوّر نفسك',tt:'جدول الحصص',links:'روابط مهمة'};
let view='home',wi=0;
const nav=$('#nav');nav.innerHTML=Object.entries(VIEWS).map(([k,v])=>`<button data-v="${k}">${v}</button>`).join('');
nav.onclick=e=>{const v=e.target.dataset.v;if(v)go(v)};
function go(v){view=v;[...nav.children].forEach(b=>b.classList.toggle('on',b.dataset.v==v));R[v]();scrollTo(0,0)}
const m=$('#m');
/* الوضع الليلي */
function theme(t){document.documentElement.dataset.theme=t;$('#th').textContent=t=='dark'?'☀️':'🌙';S.s('theme',t)}
theme(S.g('theme',matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'));
$('#th').onclick=()=>theme(document.documentElement.dataset.theme=='dark'?'light':'dark');
/* الاستريك */
const today=()=>{const d=new Date();return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate()};
function streak(){const a=S.g('days',[]);let n=0,d=new Date();const k=x=>x.getFullYear()+'-'+(x.getMonth()+1)+'-'+x.getDate();if(!a.includes(k(d)))d.setDate(d.getDate()-1);while(a.includes(k(d))){n++;d.setDate(d.getDate()-1)}return n}
const plan=()=>S.g('plan',{});const tt=()=>S.g('tt',{});
const miniTT=()=>{const t=tt(),i=new Date().getDay(),di=i>=0&&i<=4?i:-1;if(!Object.keys(t).length)return '<p>لم تحفظ جدولك بعد.</p>';return '<div class="sc"><table><tr><th></th>'+DAYS5.map((d,i)=>`<th class="dy" style="--c:${DAYC[i]}">${d}</th>`).join('')+'</tr>'+[0,1,2,3,4,5,6].map(r=>`<tr><th>${r+1}</th>${DAYS5.map((d,c)=>`<td>${t[r+'_'+c]||'-'}</td>`).join('')}</tr>`).join('')+'</table></div>'};
const R={};
R.home=()=>{const p=plan()[new Date().getDay()]||[];m.innerHTML=`<div class="hero"><img class="hl" src="${LOGO}" alt="شعار ثانوية الصدّيق"><h1>حيّاكم الله وبيّاكم، أرحبوا ملايين 👋</h1><h2>مرحبًا بكم في منصة طلاب ثانوية الصدّيق</h2><small>حاليًا فقط للصف الأول ثانوي</small><div class="gold" id="wis" style="margin-top:14px">✨ ${WIS[wi]} ✨</div></div>
<div class="card"><h2>🔥 شعلتك: ${streak()} يوم</h2><p>جدول اليوم: ${p.length?p.map(x=>`<span class="chip sj on" style="--c:${SC[x]||'#e5e9f2'}">${x}</span>`).join(''):'لم تحدد مواد اليوم'} <button class="btn" onclick="go('study')">افتح ذاكر</button></p></div>
<div class="card"><h2>🗓️ جدول حصصي</h2>${miniTT()}<button class="btn" onclick="go('tt')">عرض وتعديل</button></div>
<div class="grid">${[['study','⏱️','ذاكر','#2f5fd0'],['prac','📝','استعد','#8e44ad'],['dev','🚀','طوّر نفسك','#e67e22'],['links','🔗','روابط مهمة','#16a085']].map(a=>`<button class="tile" style="background:${a[3]}" onclick="go('${a[0]}')"><big>${a[1]}</big>${a[2]}</button>`).join('')}</div>`};
setInterval(()=>{const e=$('#wis');if(!e)return;e.style.opacity=0;setTimeout(()=>{wi=(wi+1)%WIS.length;e.textContent='✨ '+WIS[wi]+' ✨';e.style.opacity=1},400)},10000);
/* ذاكر */
let tm={mode:'f',end:0,left:1500,run:false,iv:null};
R.study=()=>{const pl=plan();m.innerHTML=`<h2>⏱️ ذاكر</h2><div class="card"><div id="md" style="text-align:center">🎯 تركيز 25 دقيقة</div><div class="timer" id="tt">25:00</div><div style="text-align:center"><button class="btn" id="ts">ابدأ</button> <button class="btn" id="tr">إعادة</button></div><h3 style="text-align:center">🔥 السلسلة: <span id="sk">${streak()}</span> يوم</h3></div>
<div class="card"><h3>جدول المذاكرة الأسبوعي</h3>${DAYS7.map((d,i)=>{const di=[6,0,1,2,3,4,5][i];return `<div><b>${d}</b> ${SUBJ.map(s=>`<span class="chip sj ${(pl[di]||[]).includes(s)?'on':''}" style="--c:${SC[s]}" data-d="${di}" data-s="${s}">${s}</span>`).join('')}</div>`}).join('')}</div>`;
$('#ts').onclick=tog;$('#tr').onclick=()=>{clearInterval(tm.iv);tm={mode:'f',end:0,left:1500,run:false,iv:null};draw()};
m.onclick=e=>{const d=e.target.dataset;if(d.s){const p=plan();p[d.d]=p[d.d]||[];const i=p[d.d].indexOf(d.s);i<0?p[d.d].push(d.s):p[d.d].splice(i,1);S.s('plan',p);e.target.classList.toggle('on')}};draw()};
function draw(){const t=$('#tt');if(!t||view!='study')return;const s=Math.max(0,tm.left);t.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');$('#md').textContent=tm.mode=='f'?'🎯 تركيز 25 دقيقة':'☕ راحة 5 دقائق';$('#ts').textContent=tm.run?'إيقاف مؤقت':'ابدأ'}
function tog(){if(tm.run){tm.run=false;clearInterval(tm.iv);tm.left=Math.ceil((tm.end-Date.now())/1000)}else{tm.run=true;tm.end=Date.now()+tm.left*1000;tm.iv=setInterval(()=>{tm.left=Math.round((tm.end-Date.now())/1000);if(tm.left<=0){clearInterval(tm.iv);tm.run=false;if(tm.mode=='f'){const a=S.g('days',[]);if(!a.includes(today())){a.push(today());S.s('days',a)}tm.mode='b';tm.left=300;alert('أحسنت! أكملت 25 دقيقة 🔥 خذ راحة 5 دقائق')}else{tm.mode='f';tm.left=1500}const k=$('#sk');if(k)k.textContent=streak()}draw()},500)}draw()}
/* استعد */
let st={sem:0,sub:null,sel:[],q:[],i:0,ok:0,bad:{}};
const shuf=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
R.prac=()=>{st.sub=null;let h='<h2>📝 استعد</h2><div class="card"><h3>اختر الفصل الدراسي</h3>'+[1,2].map(s=>`<button class="chip ${st.sem==s?'on':''}" data-sem="${s}">الفصل ${s==1?'الأول':'الثاني'}</button>`).join('')+'</div>';
if(st.sem){h+='<h3>اختر المادة</h3><div class="grid">'+SUBS[st.sem].map(s=>`<button class="tile" style="background:${s.c}" data-sub="${s.id}"><big>${s.i}</big>${s.n}</button>`).join('')+`<button class="tile" style="background:#c0902a" data-step="1"><big>🎯</big>ستيب (12 قاعدة)</button></div>`}
h+='<div class="grid" style="margin-top:12px"><div class="card soon">⭐ القدرات<br>قريبًا</div><div class="card soon">🏆 التحصيلي<br>قريبًا</div></div>';m.innerHTML=h};
function lessons(){const s=Object.values(SUBS).flat().find(x=>x.id==st.sub);st.sel=[];m.innerHTML=`<h2>${s.i} ${s.n}</h2><div class="card"><h3>حدد الدروس التي تريد أن تختبر فيها</h3>${s.l.map(l=>`<span class="chip" data-les="${l[0]}">${l[1]}</span>`).join('')}<p><button class="btn" id="go">ابدأ الاختبار</button> <button class="btn" onclick="R.prac()">رجوع</button></p><p id="er" style="color:var(--no)"></p><p class="gold" style="font-size:.85rem;color:var(--mu);text-shadow:none">بنك الأسئلة قيد التوسعة من الكتب؛ قد تقل الأسئلة عن 20 في بعض الدروس حاليًا.</p></div>`}
function start(){const pool=Q.filter(q=>st.sel.includes(q[0]));if(!pool.length){$('#er').textContent='لا توجد أسئلة جاهزة لهذه الدروس بعد؛ جرّب درسًا آخر أو أضف دروسًا.';return}st.q=shuf(pool).slice(0,20);st.i=0;st.ok=0;st.bad={};ask()}
function ask(){const q=st.q[st.i],o=shuf(q.slice(2,6));m.innerHTML=`<div class="card"><div class="bar"><i style="width:${st.i/st.q.length*100}%"></i></div><p>سؤال ${st.i+1} من ${st.q.length}</p><h3>${q[1]}</h3>${q[7]?'<div class=fig>'+q[7]+'</div>':''}${o.map(x=>`<button class="opt" data-a="${x==q[2]?1:0}">${x}</button>`).join('')}<div id="fb"></div></div>`}
function done(){const pc=Math.round(st.ok/st.q.length*100),names=Object.values(SUBS).flat().flatMap(s=>s.l);const rev=Object.keys(st.bad).map(id=>(names.find(l=>l[0]==id)||[0,id])[1]);m.innerHTML=`<div class="card" style="text-align:center"><h2>نتيجتك ${pc}%</h2><p>${st.ok} صحيحة من ${st.q.length}</p><div class="bar"><i style="width:${pc}%"></i></div></div><div class="card"><h3>دروس تحتاج مراجعة</h3>${rev.length?rev.map(r=>`<span class="chip">${r}</span>`).join(''):'ممتاز! لا يوجد 🎉'}<p><button class="btn" onclick="R.prac()">اختبار جديد</button></p></div>`}
document.addEventListener('click',e=>{if(view!='prac')return;const d=e.target.dataset;
if(d.sem){st.sem=+d.sem;R.prac()}else if(d.sub){st.sub=d.sub;lessons()}else if(d.step){m.innerHTML='<div class="card soon"><h2>🎯 ستيب</h2><p>قواعد الستيب الـ12 تُضاف قريبًا.</p><button class="btn" onclick="R.prac()">رجوع</button></div>'}
else if(d.les){const i=st.sel.indexOf(d.les);i<0?st.sel.push(d.les):st.sel.splice(i,1);e.target.classList.toggle('on')}
else if(e.target.id=='go')start();
else if(d.a!==undefined&&!document.querySelector('.opt.ok')){const q=st.q[st.i];const c=d.a==1;document.querySelectorAll('.opt').forEach(b=>{if(b.dataset.a==1)b.classList.add('ok')});if(!c){e.target.classList.add('no');st.bad[q[0]]=1}else st.ok++;
$('#fb').innerHTML=`<p><b>${c?'✅ إجابة صحيحة':'❌ إجابة خاطئة'}</b> — ${q[6]}</p><button class="btn" id="nx">${st.i+1<st.q.length?'انتقل للتالي':'إنهاء'}</button>`}
else if(e.target.id=='nx'){st.i++;st.i<st.q.length?ask():done()}});
/* طوّر نفسك */
R.dev=()=>{m.innerHTML=`<h2>🚀 طوّر نفسك</h2><p>أرحب بك في قسم طوّر نفسك، وهنا تقدر تطوّر نفسك أكثر وتتعلم أشياء جديدة!</p><div class="grid"><a class="tile" style="background:linear-gradient(135deg,#0e7c66,#16a085)" href="https://star.tuwaiq.edu.sa" target="_blank" rel="noopener"><big>💻</big><b>أكاديمية سطر</b><br>تعلّم البرمجة وعلوم الحاسب بدورات مجانية.<br><u>الدخول للأكاديمية</u></a><a class="tile" style="background:linear-gradient(135deg,#b8741a,#e67e22)" href="https://t.me/stepqrt" target="_blank" rel="noopener"><big>🎯</big><b>دورة الستيب</b><br>تدرّب على الستيب مع مجتمع الدورة.<br><u>الانضمام للدورة</u></a><div class="card soon"><big>🔒</big><br>قريبًا</div><div class="card soon"><big>🔒</big><br>قريبًا</div></div>`};
/* الجدول */
R.tt=()=>{const t=tt();m.innerHTML='<h2>🗓️ جدول الحصص</h2><div class="card sc"><table><tr><th>الحصة</th>'+DAYS5.map((d,i)=>`<th class="dy" style="--c:${DAYC[i]}">${d}</th>`).join('')+'</tr>'+[0,1,2,3,4,5,6].map(r=>`<tr><th>${r+1}</th>${DAYS5.map((d,c)=>`<td><select data-k="${r}_${c}"><option value="">—</option>${TT.map(x=>`<option ${t[r+'_'+c]==x?'selected':''}>${x}</option>`).join('')}</select></td>`).join('')}</tr>`).join('')+'</table></div><button class="btn" id="sv">حفظ</button> <span id="ok"></span>';
$('#sv').onclick=()=>{const n={};document.querySelectorAll('select[data-k]').forEach(s=>{if(s.value)n[s.dataset.k]=s.value});S.s('tt',n);$('#ok').textContent='✅ تم الحفظ، ويظهر مختصرًا في الرئيسية'}};
/* روابط */
R.links=()=>{const L=[['🏫','موقع مدرستي','https://schools.madrasati.sa','#2f5fd0'],['📘','منصة عين','https://ien.edu.sa','#16a085'],['🐦','حساب تعليق الدراسة (تويتر)','https://x.com','#34495e'],['💬','تحميل تيمز','https://www.microsoft.com/microsoft-teams/download-app','#6264a7']];m.innerHTML='<h2>🔗 روابط مهمة</h2><div class="grid">'+L.map(l=>`<a class="tile" style="background:${l[3]}" href="${l[2]}" target="_blank" rel="noopener"><big>${l[0]}</big>${l[1]}</a>`).join('')+'</div>'};
/* صالح Ai */
const bp=$('#bp');bp.innerHTML='<p><b>🤖 صالح Ai</b><br>أرحب… أنا صالح، مساعدك ودليلك البسيط في الموقع، كيف أقدر أخدمك؟</p>'+FAQ.map((f,i)=>`<button class="chip" data-f="${i}">${f[0]}</button>`).join('')+'<div id="fa"></div>';
$('#bb').onclick=()=>bp.style.display=bp.style.display=='block'?'none':'block';
bp.onclick=e=>{if(e.target.dataset.f)$('#fa').innerHTML='<p><b>'+FAQ[e.target.dataset.f][0]+'</b><br>'+FAQ[e.target.dataset.f][1]+'</p>'};
go('home');
</script>
</body>
</html>
