const FIG_S=`<svg viewBox='0 0 240 60' width='260'><line x1='10' y1='30' x2='230' y2='30' stroke='currentColor' stroke-width='2'/><g fill='currentColor' font-size='12'><circle cx='30' cy='30' r='3'/><circle cx='90' cy='30' r='3'/><circle cx='200' cy='30' r='3'/><text x='26' y='50'>A</text><text x='86' y='50'>B</text><text x='196' y='50'>C</text><text x='52' y='22'>3</text><text x='140' y='22'>4</text></g></svg>`;
const FIG_V=`<svg viewBox='0 0 200 120' width='220'><g stroke='currentColor' stroke-width='2'><line x1='20' y1='25' x2='180' y2='95'/><line x1='20' y1='95' x2='180' y2='25'/></g><g fill='currentColor' font-size='12'><text x='88' y='38'>1</text><text x='128' y='66'>2</text><text x='88' y='92'>3</text><text x='52' y='66'>4</text></g></svg>`;
Q.push(
['m1:6','مسلمة المسطرة تنص على أن النقاط على مستقيم:','يمكن ربطها بأعداد حقيقية','لا تُقاس','تعطي أعدادًا سالبة فقط','لا علاقة بالأعداد','مثل قياس القطعة بالمسطرة.'],
['m1:6','مسلمة جمع أطوال القطع: B تقع بين A وC إذا كان:','AB + BC = AC','AB = BC','AC + BC = AB','AB − BC = AC','والعكس صحيح.'],
['m1:6','في الشكل إذا كان AB = 3 وBC = 4 وB بين A وC فإن AC تساوي:','7','1','12','3.5','3 + 4 = 7.',FIG_S],
['m1:6','إذا كان AC = 10 وAB = 4 وB بين A وC فإن BC تساوي:','6','14','4','40','10 − 4 = 6.'],
['m1:6','القطعتان المستقيمتان متطابقتان إذا:','تساوى طولاهما','كانتا متوازيتين','كانتا متقاطعتين','كانتا في مستوى واحد','تعريف تطابق القطع المستقيمة.'],
['m1:6','تطابق القطع المستقيمة يحقق خصائص:','الانعكاس والتماثل والتعدي','الإبدال فقط','الجمع فقط','لا خصائص','نظرية 1.2.'],
['m1:6','«إذا AB ≅ CD وCD ≅ EF فإن AB ≅ EF» تُبرّر بخاصية:','التعدي للتطابق','التماثل','الانعكاس','القسمة','لأن طولي القطعتين يساويان نفس القيمة الثالثة.'],
['m1:6','«إذا AB ≅ CD فإن CD ≅ AB» تبرّرها خاصية:','التماثل للتطابق','التعدي','الانعكاس','الجمع','تبديل طرفي التطابق.'],
['m1:6','خاصية الانعكاس للتطابق تعني:','AB ≅ AB','AB ≅ BA فقط','AB ≅ CD','AB = 0','كل قطعة تطابق نفسها.'],
['m1:6','إذا كانت CE ≅ FE وED ≅ EG فإن CD ≅ FG لأننا نستعمل:','مسلمة جمع أطوال القطع والتعويض','التخمين فقط','التبرير الاستقرائي','القياس بالمسطرة','فتصبح CE + ED = FE + EG.'],
['m1:6','نقطة المنتصف تقسم القطعة إلى:','قطعتين متطابقتين','ثلاث قطع','قطعتين مختلفتين','أربع قطع','لهما الطول نفسه.'],
['m1:6','إذا كان JL ≅ KM فإن JK ≅ LM من خلال طرح القطعة المشتركة وهذا استعمال لخاصية:','الطرح للمساواة','الجمع للمساواة','الضرب','القسمة','لأننا طرحنا KL من الطرفين.'],
['m1:6','قاس عبدالله مترًا ثم أضاف 25 cm ليصل إلى 125 cm وهذا تطبيق لـ:','مسلمة جمع أطوال القطع','مسلمة المنقلة','قانون الفصل','المعاكس الإيجابي','100 + 25 = 125.'],
['m1:7','نظرية الزاويتين المتكاملتين: إذا تجاورت زاويتان على مستقيم فإنهما:','متكاملتان مجموعهما 180°','متتامتان مجموعهما 90°','متطابقتان','متقابلتان بالرأس','نظرية 1.3.'],
['m1:7','نظرية الزاويتين المتتامتين: إذا شكّل الضلعان غير المشتركين لزاويتين متجاورتين زاوية قائمة فإنهما:','متتامتان','متكاملتان','متقابلتان بالرأس','متلازمتان','نظرية 1.4.'],
['m1:7','مسلمة المنقلة تربط قياس زاوية بعدد حقيقي بين:','0° و 180°','0° و 90°','0° و 360°','90° و 180°','تطبيق للمنقلة.'],
['m1:7','إذا كان m∠2 = 56° وm∠JKL = 145° فإن m∠1 تساوي:','89°','201°','79°','90°','جمع قياسات الزوايا: 145 − 56.'],
['m1:7','الزاوية بين خط نظر المساح والخط الرأسي 73° فالزاوية بينه وبين الخط الأفقي:','17°','107°','73°','90°','تتم بمجموع 90° (تتامتان).'],
['m1:7','الزاويتان المكمّلتان لزاوية واحدة تكونان:','متطابقتين','متتامتين','غير متساويتين','قائمتين دائمًا','نظرية تطابق المكملات 1.6.'],
['m1:7','الزاويتان المتممتان لزاوية واحدة تكونان:','متطابقتين','متكاملتين','غير متساويتين','قائمتين','نظرية تطابق المتممات 1.7.'],
['m1:7','في الشكل الزاويتان ∠ 1 و ∠ 3 هما:','متقابلتان بالرأس ومتطابقتان','متكاملتان','متتامتان','غير متساويتين','نظرية 1.8.',FIG_V],
['m1:7','إذا كانت ∠ 3 و∠ 4 متقابلتين بالرأس وm∠3 = (6x+2)° وm∠4 = (8x−14)° فإن m∠3 تساوي:','50°','8°','62°','100°','6x+2 = 8x−14 فـ x=8 ثم 6(8)+2 = 50.'],
['m1:7','منصّف الزاوية هو مستقيم يقسمها إلى:','زاويتين متطابقتين','زاويتين متكاملتين','ثلاث زوايا','زوايا قائمة','وتكون بدايته عند رأس الزاوية.'],
['m1:7','نظرية 1.9: إذا تعامد مستقيمان فإنهما يكوّنان:','أربع زوايا قائمة','زاويتين قائمتين فقط','زوايا حادة','زوايا منفرجة','والمتعامدان يقطعان بزاوية 90°.'],
['m1:7','نظرية 1.10: جميع الزوايا القائمة:','متطابقة','متكاملة فقط','مختلفة','غير متساوية','لأن كلاً منها 90°.'],
['m1:7','إذا كانت زاويتان متكاملتين ومتطابقتين فإنهما:','قائمتان','حادتان','منفرجتان','لا يمكن تحديدهما','لأن مجموعهما 180° وكلاهما متساويان فكل منهما 90°.'],
['m1:8','المستقيمان المتوازيان هما مستقيمان:','لا يتقاطعان أبدًا ويقعان في المستوى نفسه','لا يقعان في مستوى واحد','يتقاطعان في نقطة','متعامدان','ويرمز لهما JK ∥ LM.'],
['m1:8','المستويان المتوازيان هما مستويان:','غير متقاطعين','متقاطعان في مستقيم','متقاطعان في نقطة','متطابقان فقط','مثل السقف والأرضية.'],
['m1:8','القاطع هو مستقيم:','يقطع مستقيمين أو أكثر في المستوى نفسه في نقاط مختلفة','يوازي مستقيمين','يخالف مستقيمين','يقطع نقطة واحدة فقط','ويكون عدة زوايا.'],
['m1:8','عدد الزوايا الناتجة عن قاطع يقطع مستقيمين:','8','4','6','12','أربع عند كل تقاطع.'],
['m1:8','عدد الزوايا الداخلية الناتجة عن قاطع لمستقيمين:','4','2','6','8','تقع بين المستقيمين.'],
['m1:8','في الشكل الزاويتان ∠ 1 و ∠ 5 هما:','متناظرتان','متبادلتان داخليًا','متحالفتان','متبادلتان خارجيًا','في جهة واحدة من القاطع إحداهما داخلية والأخرى خارجية.',FIG_T],
['m1:8','في الشكل الزاويتان ∠ 4 و ∠ 6 هما:','متبادلتان داخليًا','متناظرتان','متحالفتان','متبادلتان خارجيًا','كلتاهما داخلية وفي جهتين مختلفتين.',FIG_T],
['m1:8','في الشكل الزاويتان ∠ 1 و ∠ 7 هما:','متبادلتان خارجيًا','متبادلتان داخليًا','متناظرتان','متحالفتان','كلتاهما خارجية وفي جهتين مختلفتين.',FIG_T],
['m1:8','في الشكل الزاويتان ∠ 3 و ∠ 6 هما:','متحالفتان','متناظرتان','متبادلتان داخليًا','متبادلتان خارجيًا','كلتاهما داخلية في جهة واحدة من القاطع.',FIG_T],
['m1:8','الزاويتان المتحالفتان هما زاويتان:','داخليتان في جهة واحدة من القاطع','خارجيتان في جهتين مختلفتين','داخليتان في جهتين مختلفتين','إحداهما داخلية والأخرى خارجية','مثل ∠ 3 و ∠ 6 في الشكل.'],
['m1:8','الزاويتان المتناظرتان هما زاويتان في جهة واحدة من القاطع:','إحداهما داخلية والأخرى خارجية','كلتاهما داخلية','كلتاهما خارجية','متجاورتان','وغير متجاورتين.'],
['m1:8','المستقيمان غير المتقاطعين وغير الواقعين في مستوى واحد يسميان:','متخالفين','متوازيين','متعامدين','متقاطعين','أما المتوازيان في مستوى واحد.'],
['m1:9','مسلمة الزاويتين المتناظرتين: إذا قطع قاطع مستقيمين متوازيين فإن كل زاويتين متناظرتين:','متطابقتان','متكاملتان','متتامتان','غير متساويتين','مسلمة 2.1.'],
['m1:9','نظرية 2.1: الزاويتان المتبادلتان داخليًا (متوازيان):','متطابقتان','متكاملتان','قائمتان','غير مرتبطتين','نظرية المتبادلتين داخليًا.'],
['m1:9','نظرية 2.2: الزاويتان المتحالفتان (متوازيان):','متكاملتان','متطابقتان','متتامتان','قائمتان','مجموعهما 180°.'],
['m1:9','نظرية 2.3: الزاويتان المتبادلتان خارجيًا (متوازيان):','متطابقتان','متكاملتان','متتامتان','متقابلتان بالرأس فقط','نظرية المتبادلتين خارجيًا.'],
['m1:9','نظرية 2.4: إذا كان مستقيم عموديًا على أحد مستقيمين متوازيين فإنه:','عمودي على الآخر','مواز للآخر','يقطعه بزاوية حادة','يخالفه','نظرية القاطع العمودي.'],
['m1:9','في الشكل المستقيمان متوازيان وm∠1 = 110°. قياس ∠ 5:','110°','70°','180°','90°','متناظرتان فتتطابقان.',FIG_P],
['m1:9','في الشكل المستقيمان متوازيان وm∠1 = 110°. قياس ∠ 6:','70°','110°','20°','90°','∠ 6 متممة لـ ∠ 5 فهي 180−110.',FIG_P],
['m1:9','في الشكل المستقيمان متوازيان وm∠1 = 110°. قياس ∠ 3:','110°','70°','90°','180°','متقابلتان بالرأس.',FIG_P],
['m1:9','في الشكل المستقيمان متوازيان وm∠1 = 110°. قياس ∠ 4:','70°','110°','20°','160°','∠ 4 و∠ 5 متحالفتان و∠ 5 = 110°.',FIG_P],
['m1:9','إذا كان m∠1 = 85° و m∠4 = (2x−17)° وهما متحالفتان (متكاملتان) فإن x تساوي:','56','28','85','95','85 + 2x − 17 = 180 فينتج x = 56.'],
['m1:9','إذا كانت المتبادلتان داخليًا (4y+30)° و(7y+6)° والمستقيمان متوازيان فإن y:','8','6','12','24','4y+30 = 7y+6 فينتج y = 8.'],
['m1:9','إذا كان (5x+7)° و(7x−21)° متبادلتين داخليًا والمستقيمان متوازيان فإن قياس الزاوية (5x+7)° يساوي:','77°','14°','28°','103°','x = 14 ثم 5(14)+7 = 77.'],
['m1:9','إذا كان القاطع عموديًا على مستقيمين متوازيين فإن قياسات الزوايا الثماني كلها:','90°','45°','180°','مختلفة','لأنه عمودي على المستقيم الآخر أيضًا.']
);
