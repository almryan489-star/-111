Q.push(
['m1:10','عكس مسلمة الزاويتين المتناظرتين: إذا قطع قاطع مستقيمين ونتجتا زاويتان متناظرتان متطابقتان فإن المستقيمين:','متوازيان','متقاطعان','متخالفان','متعامدان','مسلمة 2.2.'],
['m1:10','مسلمة التوازي: من نقطة خارج مستقيم يمر مستقيم مواز له:','واحد فقط','مستقيمان','عدد لا نهائي','لا يوجد','مسلمة 2.3.'],
['m1:10','مسلمات الهندسة الخمس وضعها العالم:','إقليدس','الخوارزمي','نيوتن','البيروني','مؤسس الهندسة الحديثة.'],
['m1:10','عكس نظرية الزاويتين المتبادلتين خارجيًا: إذا تطابقتا فإن المستقيمين:','متوازيان','متقاطعان دائمًا','متخالفان','غير محددين','نظرية 2.5.'],
['m1:10','عكس نظرية الزاويتين المتحالفتين: إذا تكاملتا فإن المستقيمين:','متوازيان','متعامدان','متقاطعان','متخالفان','نظرية 2.6.'],
['m1:10','عكس نظرية المتبادلتين داخليًا: إذا تطابقتا فإن المستقيمين:','متوازيان','متقاطعان','متعامدان','غير محددين','نظرية 2.7.'],
['m1:10','في الشكل إذا كانت ∠ 1 ≅ ∠ 5 فإن المستقيمين الأفقيين متوازيان بحسب:','عكس مسلمة المتناظرتين','نظرية الزوايا المتقابلة بالرأس','قانون الفصل','تعريف المنصف','لأنهما متناظرتان متطابقتان.',FIG_T],
['m1:10','في الشكل إذا كانت ∠ 4 ≅ ∠ 6 فإن المستقيمين متوازيان بحسب:','عكس نظرية المتبادلتين داخليًا','عكس نظرية المتحالفتين','عكس نظرية المتبادلتين خارجيًا','مسلمة التوازي','لأنهما متبادلتان داخليًا.',FIG_T],
['m1:10','الدرجات عمودية على دعامتي السلم الرئيستين فهما متوازيتان بحسب:','عكس نظرية القاطع العمودي','نظرية المتقابلتين','قانون القياس','تعريف المنتصف','لأن المستقيمين عموديان على قاطع واحد.'],
['m1:10','زاويتان متحالفتان قياس كل منهما 135° هل تثبت توازي المستقيمين؟','لا لأن المجموع 270° ليس 180°','نعم دائمًا','نعم لأنهما متساويتان','لا يمكن الحكم','المتحالفتان يجب أن تتكاملا.'],
['m1:10','إذا كانت زاويتان متحالفتان قياساهما 120° و 60° فإن المستقيمين:','متوازيان','متقاطعان','متخالفان','لا يمكن الحكم','لأن مجموعهما 180°.'],
['m1:10','مستقيمان عموديان على القاطع نفسه في المستوى يكونان:','متوازيين','متقاطعين','متخالفين','متطابقين فقط','عكس نظرية القاطع العمودي.'],
['m1:10','أي مما يلي لا يكفي وحده لإثبات توازي مستقيمين بقاطع؟','زاويتان متتامتان','متناظرتان متطابقتان','متبادلتان داخليًا متطابقتان','متحالفتان متكاملتان','المتتامتان لا تضمن توازيًا.'],
['m1:11','ميل المستقيم هو نسبة:','التغير الرأسي إلى التغير الأفقي','التغير الأفقي إلى الرأسي','الطول إلى العرض','المساحة إلى المحيط','ويعرف أيضًا بمعدل التغير.'],
['m1:11','صيغة الميل لنقطتين (x₁,y₁) و(x₂,y₂):','m = (y₂−y₁)/(x₂−x₁)','m = (x₂−x₁)/(y₂−y₁)','m = y₁−y₂','m = x₁+x₂','مع x₁ ≠ x₂.'],
['m1:11','ميل المستقيم المار بالنقطتين (−1,−2) و(3,3) يساوي:','5/4','4/5','−5/4','1','(3−(−2))/(3−(−1)).',FIG_M],
['m1:11','ميل المستقيم المار بالنقطتين (−2,3) و(1,−3):','−2','2','−1/2','1/2','(−3−3)/(1−(−2)) = −6/3.'],
['m1:11','ميل المستقيم المار بالنقطتين (−4,−3) و(3,−3):','0','1','لا يوجد','−1','مستقيم أفقي.'],
['m1:11','ميل المستقيم المار بالنقطتين (2,1) و(2,−4):','غير معرّف','0','1','−1','لأن التغير الأفقي صفر ولا تمكن القسمة على صفر.'],
['m1:11','المستقيم الأفقي ميله:','صفر','غير معرّف','1','−1','لأن التغير الرأسي صفر.'],
['m1:11','المستقيم الرأسي ميله:','غير معرّف','صفر','1','−1','لأن التغير الأفقي صفر.'],
['m1:11','المستقيمان غير الرأسيين المتوازيان لهما:','الميل نفسه','ميلان متعاكسان في الإشارة','ميل صفر دائمًا','ميل غير معرّف','ميلا مستقيمين متوازيين متساويان.'],
['m1:11','المستقيمان غير الرأسيين متعامدان إذا كان حاصل ضرب ميليهما:','−1','1','0','2','مثل 4 و −1/4.'],
['m1:11','ميل مستقيم عمودي على مستقيم ميله 3/4 يساوي:','−4/3','4/3','−3/4','3/4','لأن (3/4)(−4/3) = −1.'],
['m1:11','مستقيمان ميلاهما 2 و −1/2 هما:','متعامدان','متوازيان','متقاطعان بزاوية 45°','متطابقان','لأن 2 × (−1/2) = −1.'],
['m1:11','طائرة تغيرت مسافتها من مدينة من 500 km إلى 152 km في نصف ساعة فمعدل التغير (الميل):','−696 km/h','696 km/h','−348 km/h','348 km/h','(152−500)/0.5 والإشارة السالبة تعني تناقص المسافة.'],
['m1:12','صيغة الميل والمقطع لمعادلة المستقيم:','y = mx + b','y − y₁ = m(x − x₁)','ax + by','y = b/x','حيث m الميل و b مقطع y.'],
['m1:12','صيغة الميل ونقطة لمعادلة المستقيم:','y − y₁ = m(x − x₁)','y = mx + b','y = x²','x = a','حيث (x₁,y₁) نقطة على المستقيم.'],
['m1:12','معادلة مستقيم ميله 3 ومقطع y له 8 هي:','y = 3x + 8','y = 8x + 3','y = 3x − 8','y = −3x + 8','بتعويض m = 3 و b = 8.'],
['m1:12','مستقيم ميله −3/4 يمر بالنقطة (−2,5) معادلته بصيغة الميل ونقطة:','y − 5 = −3/4 (x + 2)','y + 5 = −3/4 (x − 2)','y − 5 = 3/4 (x + 2)','y = −3/4 x + 5','نعوّض النقطة (−2,5) في الصيغة.'],
['m1:12','المستقيم المار بالنقطتين (0,3) و(−2,−1) معادلته:','y = 2x + 3','y = 2x − 3','y = −2x + 3','y = x + 3','ميله 2 ومقطع y يساوي 3.'],
['m1:12','معادلة المستقيم المار بالنقطتين (−2,6) و(5,6):','y = 6','x = 6','y = x + 6','y = 6x','ميله صفر (أفقي).'],
['m1:12','معادلة المستقيم الأفقي تكون:','y = b','x = a','y = mx','x + y = 0','ومعادلة الرأسي x = a.'],
['m1:12','ميل مستقيم عمودي على y = −3x + 2 يساوي:','1/3','−3','3','−1/3','لأن (−3)(1/3) = −1.'],
['m1:12','معادلة المستقيم المار بالنقطة (−1,−10) ويوازي y = 7:','y = −10','y = 7','x = −1','y = −1','مستقيم أفقي يمر بـ y = −10.'],
['m1:12','كلفة اتصال C = 0.3t + 30 فالرسوم الثابتة (مقطع y) تساوي:','30 ريالًا','0.3 ريال','60 ريالًا','0','والميل 0.3 ريال لكل دقيقة.'],
['m1:12','التكلفة C = 0.3t + 30 عند t = 100 دقيقة:','60 ريالًا','30 ريالًا','130 ريالًا','33 ريالًا','0.3×100 + 30.'],
['m1:12','إيجار قاعة y = 1500 + 15.5x عند حضور 285 شخصًا يساوي:','5917.5 ريالًا','4417.5 ريالًا','1785 ريالًا','5900 ريال','لأن 15.5×285 = 4417.5 ثم نضيف 1500.'],
['m1:12','مستقيم مقطع x له 3 ومقطع y له −2 ميله:','2/3','−2/3','3/2','−3/2','(−2−0)/(0−3).'],
['m1:13','أقصر مسافة بين نقطة ومستقيم هي المسافة:','العمودية','المائلة','الأفقية دائمًا','لا توجد','كالخيط الشاقولي.'],
['m1:13','البعد بين نقطة ومستقيم هو طول القطعة:','العمودية من النقطة على المستقيم','المائلة من النقطة','أي قطعة من النقطة','الموازية للمستقيم','وهي أقصر مسافة.'],
['m1:13','مسلمة التعامد 2.6: من نقطة خارج مستقيم يوجد مستقيم:','عمودي وحيد عليه','عموديان','لا عمودي','عدد لا نهائي من العموديات','مستقيم واحد فقط.'],
['m1:13','البعد بين مستقيمين متوازيين هو طول القطعة:','العمودية بينهما','المائلة بينهما','أطول قطعة بينهما','الأفقية بينهما','وهو ثابت عند أي نقطة.'],
['m1:13','البعد بين المستقيمين y = −2 و y = 4 يساوي:','6','2','4','8','|4 − (−2)|.'],
['m1:13','البعد بين المستقيمين x = 3 و x = 7 يساوي:','4','10','3','7','|7 − 3|.'],
['m1:13','المسافة بين النقطتين (2,4) و(−2,0) تساوي تقريبًا:','5.66','4','6','3.2','√((−2−2)²+(0−4)²) = √32.'],
['m1:13','البعد بين النقطة (5,2) والمستقيم y = −3 يساوي:','5','3','2','8','|2 − (−3)|.'],
['m1:13','البعد بين النقطة (−2,5) والمستقيم x = 4 يساوي:','6','2','4','9','|4 − (−2)|.'],
['m1:13','المحل الهندسي هو:','مجموعة النقاط التي تحقق شرطًا معينًا','نقطة واحدة فقط','مستقيم فقط','مستوى فقط','مثل النقاط المتساوية البعد.'],
['m1:13','النقطة متساوية البعد عن مستقيمين متوازيين تقع:','على مستقيم مواز لهما في منتصف المسافة','على أحدهما','خارج المستوى','في أي مكان','وهذا محل هندسي.'],
['m1:13','صيغة المسافة بين نقطتين هي:','d = √((x₂−x₁)²+(y₂−y₁)²)','d = (x₂−x₁)+(y₂−y₁)','d = x₂y₂','d = |x₁+y₁|','من نظرية فيثاغورس.'],
['m1:13','المسافة بين النقطتين (0,0) و(3,4) تساوي:','5','7','25','1','√(9+16).']
