Q.push(
['ph:0','الفيزياء علم يدرس:','المادة والطاقة وكيفية ارتباطهما','المخلوقات الحية فقط','التفاعلات الكيميائية فقط','الصخور والمعادن','وهو علم يعتمد على المشاهدات التجريبية.'],
['ph:0','تُستخدم الرياضيات في الفيزياء بوصفها:','لغة للتعبير عن القوانين ونمذجة المشاهدات','زينة فقط','لا علاقة لها بالتجارب','بديلاً عن التجربة','وتساعد على التوقع.'],
['ph:0','مقاومة مصباح يمر فيه تيار 0.75 A عند فرق جهد 120 V تساوي:','160 Ω','90 Ω','0.006 Ω','160 A','R = V/I = 120 ÷ 0.75.'],
['ph:0','تيار مار في مصباح مقاومته 50.0 Ω وفرق جهد البطارية 9.0 V يساوي:','0.18 A','450 A','5.6 A','0.018 A','I = V/R = 9.0 ÷ 50.0.'],
['ph:0','اتضح أن زمن سقوط كرة من ارتفاع 5 m المنطقي هو نحو:','1 s','0.002 s','17 s','100 s','لأن الإجابتين الأخريين غير منطقيتين مع خبرتك.'],
['ph:0','الطريقة العلمية تبدأ بـ:','طرح أسئلة بناءً على مشاهدات','كتابة القانون','نشر النتائج','النظرية','ثم الفرضيات والتجارب والتحليل.'],
['ph:0','الفرضية العلمية هي:','تخمين علمي عن كيفية ارتباط المتغيرات','حقيقة ثابتة','قانون','نظرية مثبتة','ولاختبارها تُصمم تجارب.'],
['ph:0','تساعد النماذج العلمية على:','تصور الأشياء التي تصعب رؤيتها وتفسير الظواهر','إلغاء التجارب','تغيير القوانين','إثبات الفرضيات دائمًا','مثل النماذج المتعاقبة للذرة.'],
['ph:0','القانون العلمي:','قاعدة طبيعية تصف ظاهرة متكررة دون تفسير سببها','تفسير كامل لسبب الظاهرة','تخمين غير مختبر','نموذج مادي','مثل قانون حفظ الشحنة.'],
['ph:0','قانون الانعكاس ينص على أن:','زاوية السقوط = زاوية الانعكاس','زاوية السقوط > زاوية الانعكاس','الضوء ينكسر','الضوء يتلاشى','وهو يصف ولا يفسر السبب.'],
['ph:0','النظرية العلمية هي:','إطار يفسر المشاهدات ويجمع فرضيات وقوانين ونماذج','تخمين مؤقت','قانون رياضي فقط','ملاحظة واحدة','وقد تُعدّل مع الزمن.'],
['ph:0','نظرية الجاذبية الكونية تنص على أن:','جميع الكتل تجذب بعضها بعضًا','الأجسام تسقط دائمًا بنفس اللون','الضوء أسرع من الصوت','الشحنة ثابتة','وهي أفضل تفسير ممكن للجاذبية.'],
['ph:1','القياس هو مقارنة كمية:','مجهولة بكمية معيارية','معلومة بمجهولة','مادية بمادية','رقمية برقمية','مثل قياس كتلة عربة بالكيلوجرام.'],
['ph:1','وحدة الكتلة في النظام الدولي SI:','الكيلوجرام','الجرام','النيوتن','الطن','وهي من الوحدات الأساسية السبع.'],
['ph:1','وحدة التيار الكهربائي في SI:','الأمبير','الفولت','الأوم','الواط','ورمزها A.'],
['ph:1','تحليل الوحدات يستخدم للتحقق من:','أن وحدات الإجابة صحيحة','أن الجهاز معاير','أن القياس دقيق','أن الفرضية صحيحة','مثل أن السرعة تكون بـ m/s لا m/s².'],
['ph:1','تحويل 1.34 kg إلى جرامات يساوي:','1340 g','0.00134 g','134 g','13.4 g','بالضرب في 1000 g/kg.'],
['ph:1','الدقة في القياس تعبّر عن:','مدى تقارب نتائج القياس بغض النظر عن صحتها','اتفاق النتائج مع القيمة المقبولة','عدد القياسات','نوع الجهاز','أما الضبط فيصف الاتفاق مع القيمة المقبولة.'],
['ph:1','يصف الضبط في القياس:','اتفاق نتائج القياس مع القيمة المقبولة','تقارب النتائج من بعضها','سرعة القياس','عدد الأرقام','والقيمة المقبولة اعتمدها الخبراء.'],
['ph:1','الطريقة الشائعة لاختبار ضبط الجهاز تسمى:','المعايرة','التحليل','التقدير','التمثيل','وتبدأ بمعايرة الصفر.'],
['ph:1','اختلاف القراءة بسبب زاوية النظر يسمى:','اختلاف المنظر (Parallax)','المعايرة','الدقة','النمذجة','وهو تغير موقع الجسم ظاهريًا عند اختلاف زاوية النظر.'],
['ph:1','تُقرأ تدريجات الجهاز بالنظر:','عموديًا بعين واحدة','مائلًا','بعينين من زاوية','من أي زاوية','لتتجنب خطأ اختلاف المنظر.'],
['ph:1','البادئة «كيلو» تعني مضاعفًا مقداره:','10³','10¹²','10⁻³','10⁻⁹','مثل كيلومتر = 1000 متر.'],
['ph:1','تحويل 43 km/h إلى m/s يقارب:','12 m/s','43 m/s','0.7 m/s','155 m/s','بضربها في 1000 من الكيلو وقسمتها على 3600 s.'],
['ph:2','الحركة هي تغيّر:','موقع الجسم مع الزمن','لون الجسم','كتلة الجسم','حجم الجسم فقط','ولذلك يرتبط وصفها بالمكان والزمان.'],
['ph:2','المخطط التوضيحي للحركة هو:','مواقع الجسم في فترات زمنية متساوية','صورة واحدة للجسم','جدول أرقام فقط','معادلة','ويبقى المكان الخلفي ثابتًا.'],
['ph:2','نموذج الجسيم النقطي يمثّل الجسم بـ:','نقطة صغيرة مفردة','دائرة كبيرة','مستقيم','مستطيل','ويتجاهل حركة أطرافه.'],
['ph:2','يصح استخدام نموذج الجسيم النقطي إذا كان:','حجم الجسم صغيرًا جدًا مقارنة بالمسافة التي يقطعها','الجسم كبيرًا جدًا','الجسم ساكنًا','الجسم لا كتلة له','مثل عدّاء يقطع مسافة كبيرة.'],
['ph:2','من أنواع مسارات الحركة:','خط مستقيم ودائرة ومنحنى واهتزاز','خط مستقيم فقط','دائرة فقط','لا مسارات','ونبدأ بدراسة الحركة في خط مستقيم.'],
['ph:2','في المخطط التوضيحي بعد النقاط المتساوي في فترات زمنية متساوية يعني:','سرعة ثابتة','تسارع','تباطؤ','سكون','لأن المسافة المقطوعة متساوية في كل فترة.',FIG_D1],
['ph:2','النقاط تتباعد أكثر فأكثر في فترات زمنية متساوية فهذه حركة:','سرعتها تزداد','سرعتها ثابتة','سرعتها تنتقص','الجسم ساكن','لأن الإزاحة في كل فترة تزداد.',FIG_D2],
['ph:2','في صور متعاقبة لعدّاء تبقى الخلفية:','ثابتة ويتغير موقع العدّاء','متحركة معه','متلاشية','متغيرة اللون','وهذا يدل على حركة العدّاء.'],
['ph:2','لوصف حركة أي جسم نحتاج إلى معرفة:','المكان والزمان','اللون فقط','المادة المصنوع منها','الشكل فقط','فالحركة ترتبط بهما.'],
['ph:2','مثال على الحركة الاهتزازية:','طفل يتأرجح للأمام والخلف','سيارة تتحرك باستقامة','كرة تسقط','قمر صناعي','لأن الجسم يتحرك ذهابًا وإيابًا.'],
['ph:2','المخطط التوضيحي من نوع نموذج الجسيم النقطي يسهّل عليك:','تتبّع مسار الحركة','رسم الأذرع والأرجل','حساب الكتلة','قياس درجة الحرارة','لأنه يتجاهل حركة الأذرع والأرجل.'],
['ph:3','نقطة الأصل (الإسناد) هي النقطة التي:','تكون عندها قيمة المتغيرين صفرًا','تكون عندها السرعة أعظم','يتوقف عندها الجسم','تكون نهاية المسار','وتحدد اتجاه الزيادة الموجبة.'],
['ph:3','النظام الإحداثي يحدد:','نقطة الأصل واتجاه زيادة المتغير','لون الجسم','كتلة الجسم','شكل المسار','ويؤثر في إشارة الموقع.'],
['ph:3','الكمية المتجهة هي التي تحتاج إلى:','مقدار واتجاه','مقدار فقط','اتجاه فقط','وحدة فقط','مثل الإزاحة والقوة.'],
['ph:3','أي مما يلي كمية قياسية (عددية)؟','المسافة والزمن ودرجة الحرارة','الإزاحة والقوة','الموقع والإزاحة','القوة فقط','القياسية لا اتجاه لها.'],
['ph:3','يُرمز للفترة الزمنية بالرمز:','Δt','Δd','t','v','وهي تساوي tᶠ − tᵢ.'],
['ph:3','إذا كان العدّاء عند الشجرة عند t = 1.0 s وعند العمود عند t = 5.0 s فالفترة الزمنية:','4.0 s','6.0 s','5.0 s','0.2 s','5.0 − 1.0.'],
['ph:3','الإزاحة هي:','التغير في الموقع أي الموقع النهائي مطروحًا منه الابتدائي','المسافة الكلية دائمًا','الموقع النهائي','الزمن','وهي كمية متجهة على شكل أسهم.'],
['ph:3','إذا تغيّر النظام الإحداثي فإن مقدار الإزاحة:','لا يتغير ولا اتجاهها','يتغير دائمًا','يصبح صفرًا','يصبح سالبًا','بخلاف متجهات الموقع التي تتغير.'],
['ph:3','لطرح متجه من متجه آخر:','نعكس اتجاه المتجه المطلوب طرحه ثم نجمعهما','نطرح الأطوال فقط','نضربهما','لا يمكن طرحهما','لأن A − B = A + (−B).'],
['ph:3','تحرك عدّاء من موقع 2 m إلى موقع 9 m فإن إزاحته:','7 m في اتجاه الموجب','11 m','−7 m','18 m','Δd = dᶠ − dᵢ = 9 − 2.'],
['ph:3','مشيت 0.5 km شرقًا ثم 0.5 km غربًا فإن إزاحتك تساوي:','صفرًا والمسافة 1 km','1 km','0.5 km','2 km','لأنك عدت إلى نقطة البداية.'],
['ph:3','تُمثَّل الكميات المتجهة بـ:','أسهم','نقاط فقط','دوائر','مربعات','ويدل طول السهم على المقدار.']
);
const FIG_PT=`<svg viewBox='0 0 220 155' width='240'><g stroke='currentColor' stroke-width='1.5'><line x1='30' y1='130' x2='205' y2='130'/><line x1='30' y1='10' x2='30' y2='130'/></g><line x1='30' y1='30' x2='150' y2='130' stroke='currentColor' stroke-width='3'/><g fill='currentColor' font-size='11'><text x='0' y='34'>20</text><text x='140' y='146'>4</text><text x='100' y='146'>t (s)</text><text x='36' y='14'>d (m)</text></g></svg>`;
const FIG_VT=`<svg viewBox='0 0 220 155' width='240'><g stroke='currentColor' stroke-width='1.5'><line x1='30' y1='130' x2='205' y2='130'/><line x1='30' y1='10' x2='30' y2='130'/></g><line x1='30' y1='130' x2='150' y2='30' stroke='currentColor' stroke-width='3'/><g fill='currentColor' font-size='11'><text x='6' y='34'>10</text><text x='146' y='146'>2.00</text><text x='100' y='146'>t (s)</text><text x='36' y='14'>v (m/s)</text></g></svg>`;
const FIG_X=`<svg viewBox='0 0 220 155' width='240'><g stroke='currentColor' stroke-width='1.5'><line x1='30' y1='130' x2='205' y2='130'/><line x1='30' y1='10' x2='30' y2='130'/></g><g stroke='currentColor' stroke-width='3'><line x1='30' y1='110' x2='190' y2='30'/><line x1='30' y1='40' x2='190' y2='120' stroke-dasharray='6 4'/></g><circle cx='110' cy='70' r='5' fill='currentColor'/><g fill='currentColor' font-size='11'><text x='194' y='30'>A</text><text x='194' y='124'>B</text><text x='100' y='146'>t</text><text x='36' y='14'>d</text></g></svg>`;
Q.push(
['ph:4','في منحنى (الموقع – الزمن) يمثّل المحور الأفقي:','الزمن','الموقع','السرعة','الكتلة','والموقع على المحور الرأسي.'],
['ph:4','ميل الخط في منحنى (الموقع – الزمن) يمثّل:','السرعة المتجهة المتوسطة','التسارع','الإزاحة الكلية','المساحة تحته','ووحدته m/s.'],
['ph:4','نقطة تقاطع خطين بيانيين في منحنى (الموقع – الزمن) تعني:','أن الجسمين في الموقع نفسه في تلك اللحظة','أن سرعتيهما متساويتان','أنهما تصادما حتمًا','أن تسارعهما متساوٍ','لكنهما قد لا يتصادمان مثل عدّاءين في ممرين مختلفين.',FIG_X],
['ph:4','تُمثَّل الحركة بطرائق متكافئة منها:','الكلمات والصور والمخططات والجداول والمنحنيات','الكلمات فقط','الصور فقط','المعادلات فقط','وكلها تحتوي معلومات الحركة نفسها.'],
['ph:4','الجسم الساكن يُمثَّل في منحنى (الموقع – الزمن) بخط:','أفقي','مائل لأعلى','مائل لأسفل','رأسي','لأن موقعه لا يتغير مع الزمن.'],
['ph:4','من المنحنى الموضح الموقع الابتدائي للجسم (عند t = 0) يساوي:','20 m','4 m','−5 m','0 m','نقطة تقاطع الخط مع المحور الرأسي.',FIG_PT],
['ph:4','ميل الخط في المنحنى الموضح يساوي:','−5 m/s','5 m/s','−4 m/s','20 m/s','(0 − 20)/(4 − 0).',FIG_PT],
['ph:4','متى يصل الجسم الممثّل في المنحنى إلى نقطة الأصل (d = 0)؟','عند t = 4 s','عند t = 20 s','عند t = 0','لا يصل أبدًا','عند تقاطع الخط مع محور الزمن.',FIG_PT],
['ph:4','معادلة الحركة المنتظمة:','d = vt + dᵢ','d = v/t','d = vt²','d = t − v','شبيهة بمعادلة الخط y = mx + b.'],
['ph:4','في المعادلة d = (−5.0 m/s)t + 20.0 m عند t = 2.0 s يكون الموقع:','10.0 m','−10.0 m','30.0 m','15.0 m','بالتعويض: −5×2 + 20.'],
['ph:4','المقطع الرأسي للخط في منحنى (الموقع – الزمن) يمثّل:','الموقع الابتدائي','السرعة','التسارع','الزمن الكلي','أي الموقع عند t = 0.'],
['ph:4','الجسمان اللذان لهما خطان متقاطعان في منحنى الموقع-الزمن فالأكثر انحدارًا (بقيمة مطلقة) هو الأكبر:','سرعة','كتلة','موقعًا ابتدائيًا','تسارعًا','لأن الميل يمثّل السرعة.'],
['ph:4','وحدة ميل الخط في منحنى (الموقع-الزمن) هي:','m/s','m','s','m/s²','تُقسم الإزاحة على الزمن.'],
['ph:4','تُستخدم المنحنيات للإجابة عن أسئلة مثل:','متى وأين يتجاوز عدّاء آخر','ما لون العدّاء','ما كتلة العدّاء','ما اسم المسابقة','لأنها تبيّن الموقع مع الزمن.'],
['ph:4','للجسم المتحرك بسرعة ثابتة منحنى (الموقع – الزمن) على شكل:','خط مستقيم مائل','منحنى متصاعد','نقطة واحدة','دائرة','لأن الميل ثابت.'],
['ph:5','السرعة المتجهة المتوسطة تساوي:','الإزاحة الكلية مقسومة على الفترة الزمنية','المسافة الكلية فقط','الفترة مقسومة على الإزاحة','السرعة اللحظية دائمًا','وهي ميل الخط البياني للموقع-الزمن.'],
['ph:5','السرعة المتوسطة (مقدار السرعة) تساوي:','القيمة المطلقة للسرعة المتجهة المتوسطة','السرعة المتجهة اللحظية','التسارع','الإزاحة','فهي لا تحمل اتجاهًا.'],
['ph:5','الميل السالب في منحنى (الموقع-الزمن) يعني:','أن الجسم يتحرك في الاتجاه السالب','أن الجسم ساكن','أن الجسم يتباطأ دائمًا','أن الكتلة سالبة','وإزاحته سالبة.'],
['ph:5','عدّاء تغير موقعه من 6.0 m إلى 12.0 m في الفترة من 3.5 s إلى 7.0 s فسرعته المتجهة المتوسطة نحو:','1.7 m/s','3.4 m/s','0.6 m/s','6 m/s','(12−6)/(7.0−3.5).'],
['ph:5','السرعة المتجهة اللحظية هي السرعة عند:','لحظة زمنية محددة','نهاية الرحلة فقط','بداية الرحلة فقط','المتوسط دائمًا','ونرمز لها بالرمز v.'],
['ph:5','إذا كانت السرعة اللحظية ثابتة فإن الحركة:','منتظمة وتساوي المتوسطة','متسارعة','متباطئة','متقطعة','فالميل ثابت.'],
['ph:5','السرعة المتجهة كمية متجهة أما السرعة (المقدار) فهي:','كمية قياسية','كمية متجهة','سالبة دائمًا','لا وحدة لها','لا تحتاج اتجاهًا.'],
['ph:5','عدّاءان قطعا 100 m أحدهما أسرع فهو:','يستغرق فترة زمنية أقل','يستغرق فترة أطول','إزاحته أقل','كتلته أكبر','لأن السرعة = الإزاحة/الزمن.'],
['ph:5','المخطط التوضيحي للحركة يبين فقط المواقع عند:','بداية الفترات الزمنية ونهايتها','كل لحظة زمنية','النقاط المتوسطة فقط','عند السكون فقط','لذا يعطي المتوسط لا اللحظي.'],
['ph:5','جسم ميل منحنى موقعه -زمنه يساوي −5.0 m/s فسرعته المتوسطة تساوي:','5.0 m/s','−5.0 m/s','0','25 m/s','القيمة المطلقة للسرعة المتجهة.'],
['ph:5','المعادلة d = (−5.0 m/s)t + 20.0 m تصف حركة:','منتظمة باتجاه سالب','متسارعة','ساكنة','دائرية','من موقع ابتدائي 20.0 m.'],
['ph:5','الميل في منحنى (الموقع-الزمن) يدل على:','السرعة المتجهة لا على مقدار السرعة فحسب','التسارع','الكتلة','الزمن الكلي','لأنه يحمل الاتجاه أيضًا.'],
['ph:5','عدّاء سرعته المنتظمة 4 m/s لمدة 10 s يقطع إزاحة:','40 m','2.5 m','14 m','0.4 m','الإزاحة = السرعة × الزمن.'],
['ph:6','التسارع هو:','المعدل الزمني لتغير السرعة المتجهة','معدل تغير الإزاحة','السرعة نفسها','القوة','وهو كمية متجهة.'],
['ph:6','وحدة التسارع في النظام الدولي:','m/s²','m/s','m','s/m','متر لكل ثانية لكل ثانية.'],
['ph:6','ميل منحنى (السرعة المتجهة – الزمن) يمثّل:','التسارع','الإزاحة','الموقع','الكتلة','والمساحة تحته تمثّل الإزاحة.'],
['ph:6','تسارع السيارة الممثّلة بالمنحنى (من السكون إلى 10 m/s في 2.00 s):','5.00 m/s²','20 m/s²','0.2 m/s²','12 m/s²','(10 − 0)/2.00.',FIG_VT],
['ph:6','الجسم المتحرك بسرعة منتظمة تسارعه:','صفر','يساوي السرعة','موجب دائمًا','سالب دائمًا','لأن السرعة لا تتغير.'],
['ph:6','في المخطط التوضيحي لجسم يزداد سرعة تكون المسافات بين النقاط:','تتزايد','ثابتة','تتناقص','صفرًا','ومتجهات السرعة تكبر.'],
['ph:6','في المخطط التوضيحي لجسم يتباطأ تكون المسافات بين النقاط:','تتناقص','تتزايد','ثابتة','متغيرة عشوائيًا','ومتجهات السرعة تصغر.'],
['ph:6','التسارع المتوسط يساوي:','التغير في السرعة المتجهة مقسومًا على الزمن','السرعة مقسومة على المسافة','الإزاحة مقسومة على الزمن','القوة مقسومة على الكتلة','أي a = Δv/Δt.'],
['ph:6','سيارة سباق زادت سرعتها من 4.0 m/s إلى 36 m/s خلال 4.0 s فتسارعها المتوسط:','8.0 m/s²','32 m/s²','10 m/s²','1 m/s²','(36−4)/4.0.'],
['ph:6','سيارة تباطأت من 36 m/s إلى 15 m/s خلال 3.0 s فتسارعها المتوسط:','−7.0 m/s²','7.0 m/s²','−17 m/s²','17 m/s²','(15−36)/3.0.'],
['ph:6','حافلة تسير بسرعة 25 m/s توقفت بعد 3.0 s فتسارعها المتوسط تقارب:','−8.3 m/s²','8.3 m/s²','−75 m/s²','0','(0−25)/3.0 والإشارة السالبة تعني تباطؤًا.'],
['ph:6','عندما تكون السرعة والتسارع في الاتجاه نفسه فإن سرعة الجسم:','تزداد','تنتقص','تبقى ثابتة','تنعدم','أما في اتجاهين متعاكسين فتتناقص.'],
['ph:6','إذا كان اتجاه التسارع عكس اتجاه السرعة فإن الجسم:','يتباطأ','يتسارع','يتوقف دائمًا','يتحرك بسرعة ثابتة','مثل قطة تنزلق حتى تقف.'],
['ph:6','إشارة التسارع وحدها:','لا تحدد أن الجسم يتسارع أم يتباطأ','تحدد أنه يتسارع دائمًا','تحدد أنه يتباطأ دائمًا','تحدد الكتلة','لأنها تعتمد على الاتجاهين معًا.']
);
Q.push(
['ph:5','وحدة السرعة المتجهة في النظام الدولي هي:','m/s','m/s²','m','s','نفس وحدة السرعة القياسية.'],
['ph:6','التسارع اللحظي يُستخرج من منحنى (السرعة – الزمن) بـ:','ميل المماس عند اللحظة المطلوبة','المساحة تحت المنحنى','القيمة القصوى','المحور الأفقي','لأن التسارع هو ميل المنحنى.'],
['ph:7','السرعة المتجهة النهائية بدلالة التسارع الثابت تساوي:','vᶠ = vᵢ + aΔt','vᶠ = vᵢ − aΔt','vᶠ = a/Δt','vᶠ = vᵢ·aΔt','من a = (vᶠ − vᵢ)/Δt.'],
['ph:7','المساحة تحت منحنى (السرعة المتجهة – الزمن) تساوي عدديًا:','إزاحة الجسم','تسارعه','كتلته','زمن حركته فقط','لأن d = v·t مساحة مستطيل.'],
['ph:7','علاقة الإزاحة بالتسارع الثابت من السكون (الموقع الابتدائي صفر):','d = ½ a t²','d = a t','d = a/t','d = a t³','من d = vᵢt + ½ a t² مع vᵢ = 0.'],
['ph:7','المعادلة التي لا تحتوي الزمن هي:','vᶠ² = vᵢ² + 2aΔd','vᶠ = vᵢ + at','d = vᵢt + ½ at²','a = Δv/Δt','وتستعمل عند جهل الزمن.'],
['ph:7','سيارة انطلقت من السكون بتسارع 3.5 m/s² فالمسافة عندما تصل سرعتها إلى 25 m/s تقارب:','89 m','7 m','175 m','44 m','25²/(2×3.5).'],
['ph:7','طائرة تتحرك بسرعة ثابتة 75 m/s مدة 2.0 s تقطع إزاحة:','150 m','37.5 m','75 m','77 m','75 × 2.0.'],
['ph:7','مسافة الاستجابة لسائق يسير بـ 25 m/s وزمن استجابته 0.45 s تساوي نحو:','11 m','56 m','0.45 m','25 m','السرعة ثابتة فالإزاحة = v·t.'],
['ph:7','مسافة الفرملة لسيارة سرعتها 25 m/s وتباطؤها 8.5 m/s² تقارب:','37 m','3 m','74 m','212 m','25²/(2×8.5).'],
['ph:7','متزلج سرعته 1.75 m/s تباطأ بتسارع ثابت 0.20 m/s² حتى توقف خلال نحو:','8.8 s','0.35 s','2.0 s','35 s','t = 1.75/0.20.'],
['ph:7','سيارة تباطأت من 44 m/s إلى 22 m/s خلال 11 s فالمسافة التي قطعتها:','363 m','242 m','484 m','33 m','((44+22)/2)×11.'],
['ph:7','سيارة تتسارع من 15 m/s إلى 25 m/s في مسافة 125 m فالزمن نحو:','6.25 s','5.0 s','12.5 s','3.1 s','t = 2d/(vᵢ+vᶠ) = 250/40.'],
['ph:7','منحنى (الموقع – الزمن) للتسارع الثابت هو:','منحنى يزداد ميله مع الزمن','خط مستقيم أفقي','خط مستقيم مائل ثابت الميل','نقطة','لأن السرعة تتزايد.'],
['ph:7','منحنى (السرعة المتجهة – الزمن) للتسارع الثابت هو:','خط مستقيم ميله التسارع','منحنى متصاعد','خط أفقي دائمًا','نقطة','ميله ثابت لأن التسارع ثابت.'],
['ph:7','طائرة بدأت من السكون بتسارع 3.00 m/s² مدة 30.0 s فإن سرعتها عند الإقلاع:','90.0 m/s','10.0 m/s','900 m/s','33 m/s','v = at = 3.00×30.0.'],
['ph:8','السقوط الحر هو حركة جسم:','تحت تأثير الجاذبية فقط','بوجود مقاومة هواء كبيرة','بسرعة ثابتة','تحت قوة دفع مستمرة','مثل حجر يسقط مع إهمال الهواء.'],
['ph:8','قيمة التسارع الناجم عن الجاذبية الأرضية قرب سطح الأرض:','9.80 m/s²','98 m/s²','0.98 m/s²','1 m/s²','وتتغير قليلًا بالبُعد عن مركز الأرض.'],
['ph:8','تسقط ورقة مفرودة أبطأ من حصاة بسبب:','تأثير مقاومة الهواء فيها أكبر','اختلاف الجاذبية','اللون','تسارعها أكبر','لأن مساحة سطحها كبيرة مقارنة بكتلتها.'],
['ph:8','كرتان متماثلتا الحجم من الألومنيوم والفولاذ أُسقطتا من الارتفاع نفسه فتصلان:','في اللحظة نفسها تقريبًا','الفولاذ أولًا بكثير','الألومنيوم أولًا بكثير','لا تصلان','لأن تسارع السقوط الحر لا يعتمد على الكتلة.'],
['ph:8','تسارع الجاذبية على القمر يساوي تقريبًا:','سدس تسارع الجاذبية على الأرض','ضعفه','نفسه','عشره','لذلك تسقط الأجسام ببطء أكثر.'],
['ph:8','كرة مقذوفة لأعلى والاتجاه لأعلى موجب تكون إشارة تسارعها:','سالبة وقيمتها 9.80 m/s²','موجبة','صفر','تتغير','لأن التسارع لأسفل دائمًا.'],
['ph:8','عند أقصى ارتفاع لكرة مقذوفة لأعلى:','السرعة صفر لكن التسارع لا يساوي صفرًا','السرعة والتسارع صفر','التسارع صفر فقط','السرعة أكبر ما يمكن','وإلا بقيت معلّقة في الهواء.'],
['ph:8','قطعة قرميد أُسقطت من سطح بناية فسرعتها بعد 4.0 s تقارب:','39 m/s','2.5 m/s','78 m/s','9.8 m/s','v = gt = 9.8×4.0.'],
['ph:8','المسافة التي قطعتها قطعة القرميد خلال 4.0 s من السكون:','78 m','39 m','157 m','9.8 m','d = ½ g t² = ½(9.8)(16).'],
['ph:8','كرة أُسقطت من نافذة ارتفاعها 3.5 m فسرعتها عند الرصيف تقارب:','8.3 m/s','34 m/s','3.5 m/s','0.8 m/s','v = √(2gh) = √(2×9.8×3.5).'],
['ph:8','كرة تنس قُذفت لأعلى بسرعة 22.5 m/s فأقصى ارتفاع تصل إليه:','25.8 m','51.7 m','2.3 m','12.9 m','h = v²/(2g) = 506/19.6.'],
['ph:8','الزمن الذي بقيت فيه كرة التنس المقذوفة بـ 22.5 m/s في الهواء تقارب:','4.6 s','2.3 s','9.2 s','1.1 s','t = 2v/g = 2×22.5/9.8.'],
['ph:8','كرة وصلت أقصى ارتفاع 0.25 m فسرعتها الابتدائية تقارب:','2.2 m/s','4.9 m/s','0.5 m/s','25 m/s','v = √(2gh) = √4.9.'],
['ph:8','زمن صعود كرة مقذوفة رأسيًا يساوي زمن هبوطها:','عندما تعود إلى الارتفاع نفسه','دائمًا مختلف','ضعفه','نصفه','بإهمال مقاومة الهواء.']
);
const FIG_FB=`<svg viewBox='0 0 200 150' width='220'><rect x='70' y='55' width='60' height='40' fill='none' stroke='currentColor' stroke-width='2'/><g stroke='currentColor' stroke-width='3'><line x1='100' y1='55' x2='100' y2='12'/><line x1='100' y1='95' x2='100' y2='138'/></g><g fill='currentColor'><polygon points='100,6 94,18 106,18'/><polygon points='100,144 94,132 106,132'/><text x='108' y='28' font-size='12'>FN</text><text x='108' y='128' font-size='12'>Fg</text></g><line x1='40' y1='95' x2='160' y2='95' stroke='currentColor' opacity='.4'/></svg>`;
Q.push(
['ph:9','القوة هي:','دفع أو سحب يؤثر في جسم','كتلة الجسم','سرعة الجسم','زمن حركته','وتغيّر سرعته أو اتجاهه.'],
['ph:9','عندما تؤثر قوة محصلة في جسم فإنها:','تغيّر سرعته المتجهة أي تكسبه تسارعًا','لا تغيّر شيئًا','تزيد كتلته','تجعله ساكنًا دائمًا','حسب تعريف التسارع.'],
['ph:9','وحدة القوة في النظام الدولي:','النيوتن N','الجول J','الواط W','الباسكال Pa','وهي تساوي kg·m/s².'],
['ph:9','النيوتن هو القوة التي:','تكسب كتلة 1 kg تسارعًا 1 m/s²','تكسب كتلة 1 kg سرعة 1 m/s','ترفع 1 kg مترًا','تحرك 1 kg ثانية','تعريف النيوتن.'],
['ph:9','قوة الجاذبية الأرضية تُعد:','قوة مجال','قوة تلامس فقط','قوة احتكاك','قوة شد','لأنها تؤثر دون تلامس.'],
['ph:9','مخطط الجسم الحر يمثّل:','جميع القوى المؤثرة في الجسم بأسهم','مسار الحركة','الموقع مع الزمن','كتلة الجسم','ويساعد على حساب القوة المحصلة.'],
['ph:9','العلاقة بين القوة وتسارع نفس الجسم:','خطية طردية','عكسية','لا علاقة','تربيعية عكسية','فكلما زادت القوة زاد التسارع.'],
['ph:9','القوة المحصلة هي:','مجموع متجهات جميع القوى المؤثرة في الجسم','أكبر قوة فقط','متوسط القوى','القوة الأولى فقط','وهي التي تحدد التسارع.'],
['ph:9','قوتان أفقيتان 225 N و165 N تؤثران في قارب في الاتجاه نفسه فالمحصلة:','390 N','60 N','225 N','165 N','جمع القوتين في الاتجاه نفسه.'],
['ph:9','قوتان 100 N في اتجاهين متعاكسين على طاولة تجعل المحصلة:','صفرًا فلا تتسارع','200 N','100 N','لا تحسب','لأنهما متساويتان ومتعاكستان.'],
['ph:9','قوتان 100 N في الاتجاه نفسه على طاولة تجعل المحصلة:','200 N','0','100 N','50 N','وتتسارع الطاولة في اتجاهها.'],
['ph:9','قانون نيوتن الأول ينص على أن الجسم:','يبقى على حالته من السكون أو الحركة المنتظمة ما لم تؤثر فيه قوة محصلة','يتسارع دائمًا','يتوقف تلقائيًا','يسقط دائمًا','ويسمى قانون القصور الذاتي.'],
['ph:9','القصور الذاتي هو ميل الجسم إلى:','مقاومة التغير في حالته الحركية','السقوط','التسارع دائمًا','التوقف','ومقداره يعتمد على الكتلة.'],
['ph:9','كتاب ساكن على طاولة القوة العمودية FN عليه تساوي:','الوزن فتكون المحصلة صفرًا','ضعف الوزن','نصف الوزن','صفرًا','لأنه ساكن ولا تسارع.',FIG_FB],
['ph:10','قانون نيوتن الثاني يكتب:','a = Fالمحصلة / m','a = F × m','a = m / F','a = F + m','فالتسارع طردي مع القوة وعكسي مع الكتلة.'],
['ph:10','طاولة كتلتها 15.0 kg دفعها شخصان بقوة 50.0 N لكل منهما في الاتجاه نفسه فتسارعها:','6.67 m/s²','3.33 m/s²','1500 m/s²','0.15 m/s²','100.0 ÷ 15.0.'],
['ph:10','وسادة كتلتها 0.30 kg يسحبها خالد بـ 11.0 N وسامي بـ 10.0 N في اتجاه معاكس فتسارعها:','3.3 m/s²','70 m/s²','1.0 m/s²','0','(11.0 − 10.0)/0.30.'],
['ph:10','وزن الجسم يساوي:','كتلته × تسارع الجاذبية','كتلته ÷ g','كتلته + g','حجمه × g','Fᵍ = mg.'],
['ph:10','وزن شخص كتلته 70 kg على الأرض يقارب:','686 N','70 N','7.1 N','6860 N','70 × 9.8.'],
['ph:10','يبين ميزان منزلي أن وزنك 585 N فكتلتك تقارب:','59.7 kg','5733 kg','585 kg','0.017 kg','m = F/g = 585/9.8.'],
['ph:10','عند الانتقال إلى القمر تبقى كتلتك:','ثابتة ويقل وزنك','تقل ويبقى الوزن','تزداد','تنعدم','لأن g على القمر أقل.'],
['ph:10','الوزن الظاهري للشخص هو:','القوة التي يؤثر بها الميزان فيه','كتلته الحقيقية','قوة الجاذبية دائمًا','صفر دائمًا','وقد يختلف عن الوزن الحقيقي.'],
['ph:10','عندما يتسارع مصعد لأعلى تكون قراءة الميزان مقارنة بالسكون:','أكبر','أقل','مساوية','صفرًا','لأن FN = m(g + a).'],
['ph:10','شخص كتلته 75.0 kg في مصعد يتسارع لأعلى بـ 2.00 m/s² قراءة ميزانه تقارب:','885 N','735 N','585 N','150 N','75×(9.8+2.0).'],
['ph:10','الشخص نفسه (75.0 kg) في مصعد ساكن قراءة الميزان تقارب:','735 N','75 N','885 N','588 N','75 × 9.8.'],
['ph:10','عند تسارع المصعد لأسفل تكون قراءة الميزان:','أقل من الوزن الحقيقي','أكبر','مساوية','صفرًا دائمًا','لأن FN = m(g − a).'],
['ph:10','القوة المعيقة هي قوة:','تمانع حركة جسم داخل مائع مثل الهواء','تسرّع الجسم دائمًا','تجذب الجسم للأرض','تزيد كتلته','وتزداد مع السرعة.'],
['ph:10','السرعة الحدّية تحدث عندما:','تتساوى القوة المعيقة مع قوة الجاذبية','تكون القوة المعيقة صفرًا','تنعدم الجاذبية','يتوقف الجسم','فتصبح المحصلة صفرًا ويهبط بسرعة ثابتة.'],
['ph:11','قانون نيوتن الثالث ينص على أن القوى تظهر على شكل:','أزواج متساوية مقدارًا ومتعاكسة اتجاهًا','أزواج متساوية ومتشابهة اتجاهًا','قوى منفردة','مجموعات متشابهة','وتؤثر في جسمين مختلفين.'],
['ph:11','قوتا زوج الفعل ورد الفعل تؤثران في:','جسمين مختلفين','الجسم نفسه','نقطة واحدة فقط','الهواء فقط','ولذلك لا تُلغي إحداهما الأخرى.'],
['ph:11','الصيغة الرياضية لقانون نيوتن الثالث:','F(A→B) = −F(B→A)','F(A→B) = F(B→A)','F(A→B) + F(B→A) = 2F','F(A→B) × F(B→A) = 1','أي متساويتان مقدارًا ومتعاكستان اتجاهًا.'],
['ph:11','لماذا لا تُلغي قوتا التأثير المتبادل بعضها بعضًا؟','لأنها تؤثر في جسمين مختلفين','لأنها غير متساوية','لأنها في نفس الاتجاه','لأنها تعمل في أوقات مختلفة','فالمحصلة تُحسب لكل جسم على حدة.'],
['ph:11','عندما دفعت ظهر صديقك وأنتما على حذاء تزلج تحركت أنت للخلف لأن:','صديقك أثر فيك بقوة مساوية ومعاكسة','الهواء دفعك','جسمك أخف','الأرض جذبتك','قانون نيوتن الثالث.'],
['ph:11','عندما تشد حبلًا بيدك فإن الحبل يشدّ يدك:','بقوة مساوية ومعاكسة','بقوة أكبر','بقوة أصغر','لا يؤثر','وهذا من قوى الشد.'],
['ph:11','قوة الشد هي قوة:','يؤثر بها خيط أو حبل في جسم متصل به','تمنع الانزلاق','تمنع الغوص','تنشأ من الجاذبية','وتكون موازية للخيط.'],
['ph:11','القوة العمودية تؤثر بها السطح في الجسم:','عموديًا على سطحي التلامس','موازية للسطح','لأسفل دائمًا','في اتجاه الحركة','واتجاهها للخارج من السطح.'],
['ph:11','زوج التأثير المتبادل لوزن كتاب (جذب الأرض للكتاب) هو:','جذب الكتاب للأرض','القوة العمودية من الطاولة','الاحتكاك','الشد','قوة الأرض عليه وقوة الكتاب على الأرض.'],
['ph:11','كرة كتلتها 0.18 kg تسقط فقوة الأرض عليها تقارب:','1.8 N','0.018 N','18 N','0.18 N','F = mg = 0.18 × 9.8.'],
['ph:11','قوة جذب الكرة الساقطة للأرض تساوي مقدار وزنها لكنها:','لا تسبب تسارعًا ملحوظًا للأرض لكبر كتلتها','توقف الأرض','تقل من وزن الكرة','لا توجد','فتسارعها ضئيل جدًا.'],
['ph:11','صاروخ ينطلق لأعلى لأن الغازات المتدفقة لأسفل تدفعه من خلال:','قانون نيوتن الثالث','قانون نيوتن الأول فقط','الاحتكاك','قوة الشد','الغاز يدفع الصاروخ بقوة مساوية.'],
['ph:11','القوتان المتبادلتان بين نظامين تكونان دائمًا:','متساويتين مقدارًا ومتعاكستين اتجاهًا','مختلفتين مقدارًا','في اتجاه واحد','محصلتهما موجبة دائمًا','بغض النظر عن كتل النظامين.']
);
const FIG_I=`<svg viewBox='0 0 240 140' width='250'><polygon points='20,120 210,120 210,45' fill='none' stroke='currentColor' stroke-width='2'/><g transform='rotate(-21 120 78)'><rect x='100' y='62' width='36' height='22' fill='none' stroke='currentColor' stroke-width='2'/></g><g fill='currentColor' font-size='12'><text x='50' y='115'>30°</text><text x='84' y='56'>Fg = 562 N</text></g></svg>`;
Q.push(
['ph:9','تسارع الجسم يتحدد بـ:','القوة المحصلة المؤثرة فيه','أكبر قوة فقط','القوة الأولى فقط','لونه','وكتلته أيضًا.'],
['ph:11','قوة الشد تمثّل:','قوة يؤثر بها حبل أو خيط في الجسم المربوط به','وزن الجسم','قوة الاحتكاك','قوة مجال','وتكون موازية للحبل.'],
['ph:12','عند جمع متجهين بالرسم توضع:','ذيل متجه على رأس الآخر','رأسا المتجهين معًا','ذيلا المتجهين معًا','متجهان متقابلان','ومن ثم ترسم المحصلة.'],
['ph:12','المتجه المحصل هو المتجه الذي يصل:','ذيل المتجه الأول برأس المتجه الأخير','رأسي المتجهين','ذيلي المتجهين','منتصفيهما','ويُقاس مقداره واتجاهه.'],
['ph:12','اتجاه المتجه هو الزاوية التي يصنعها مع:','محور x الموجب عكس عقارب الساعة','محور y فقط','الشمال دائمًا','اتجاه عقارب الساعة','وهذا تعريف الكتاب.'],
['ph:12','المركّبة الأفقية لمتجه A بزاوية θ مع محور x:','A cos θ','A sin θ','A tan θ','A/cos θ','الضلع المجاور للزاوية.'],
['ph:12','المركّبة الرأسية لمتجه A بزاوية θ مع محور x:','A sin θ','A cos θ','A tan θ','A/sin θ','الضلع المقابل للزاوية.'],
['ph:12','زاوية المتجه المحصل تساوي:','tan⁻¹(R_y / R_x)','tan⁻¹(R_x / R_y)','sin⁻¹(R_y)','cos⁻¹(R_x)','أي ظل الزاوية يساوي خارج قسمة المركّبتين.'],
['ph:12','إزاحتان 25 km و 15 km الزاوية بينهما 90° مقدار محصلتهما تقارب:','29 km','40 km','10 km','20 km','√(25² + 15²) بنظرية فيثاغورس.'],
['ph:12','قانون جيب التمام لجمع متجهين هو:','R² = A² + B² − 2AB cos θ','R = A + B','R² = A² − B²','R = AB sin θ','حيث θ الزاوية بين المتجهين المرسومين ذيلاً لرأس.'],
['ph:12','ما القانون الذي يربط مقادير المتجهات بجيوب الزوايا المقابلة؟','قانون الجيب','قانون نيوتن','قانون أوم','قانون هوك','R/sin θ = A/sin a.'],
['ph:12','مشيت 8.0 km شمالًا ثم شرقًا فأصبحت إزاحتك 10.0 km. المسافة شرقًا:','6.0 km','2.0 km','12.8 km','18 km','√(10² − 8²).'],
['ph:12','سيارة قطعت 125.0 km غربًا ثم 65.0 km جنوبًا فإزاحتها تقارب:','141 km','190 km','60 km','110 km','√(125² + 65²).'],
['ph:12','المركّبة x لمتجه مقداره 15.0 km بزاوية 140.0° تساوي:','−11.5 km','11.5 km','9.64 km','−9.64 km','15.0 cos 140°.'],
['ph:12','المركّبة y للمتجه نفسه (15.0 km بزاوية 140.0°) تساوي:','9.64 km','−9.64 km','11.5 km','15.0 km','15.0 sin 140°.'],
['ph:12','تكون إشارة إحدى المركّبتين أو كلتيهما سالبة عندما تكون الزاوية مع x الموجب:','أكبر من 90°','أقل من 90° دائمًا','مساوية لـ 0° فقط','لا تكون سالبة أبدًا','لأن cos و sin تتغيران إشارتهما.'],
['ph:12','تبدأ خطوات حل مسائل جمع المتجهات بـ:','اختيار نظام إحداثي ثم تحليل المتجهات إلى مركّبات','جمع الأطوال مباشرة','ضرب المتجهات','قسمة المتجهات','ثم جمع المركّبات وإيجاد المقدار والاتجاه.'],
['ph:13','الاحتكاك هو قوة تلامس:','تعاكس الحركة الانزلاقية بين سطحين','تساعد الحركة','تجذب الجسم للأرض','تزيد الكتلة','وهي موازية للسطح.'],
['ph:13','نوعا الاحتكاك هما:','السكوني والحركي','الأفقي والرأسي','اللحظي والمتوسط','الخشن والناعم','وكلاهما له معامل خاص.'],
['ph:13','الاحتكاك السكوني يعمل على:','منع بدء حركة الجسم الساكن','منع توقف جسم متحرك','تسريع الجسم','تقليل كتلة الجسم','وقوته تزداد حتى قيمتها القصوى.'],
['ph:13','الاحتكاك الحركي يكون بين سطحين:','ينزلقان أحدهما على الآخر','ساكنين نسبيًا','بعيدين','منفصلين','ويعاكس اتجاه الانزلاق.'],
['ph:13','تعتمد قوة الاحتكاك بشكل أساسي على:','نوع السطحين والقوة العمودية بينهما','مساحة التلامس فقط','السرعة فقط','لون السطح','ولا تتغير بتغير مساحة السطح.'],
['ph:13','من العوامل التي لا تؤثر في الاحتكاك الحركي:','مساحة السطح والسرعة','نوع المادة','القوة العمودية','معامل الاحتكاك','كما أثبتت التجارب.'],
['ph:13','قوة الاحتكاك الحركي تساوي:','μ_k × F_N','μ_k ÷ F_N','μ_k + F_N','F_N ÷ μ_k','حاصل ضرب المعامل في القوة العمودية.'],
['ph:13','قوة الاحتكاك السكوني تحقق:','f_s ≤ μ_s F_N','f_s = μ_k F_N دائمًا','f_s > μ_s F_N','f_s = 0 دائمًا','والقيمة القصوى هي μ_s F_N.'],
['ph:13','معامل الاحتكاك السكوني عادة يكون مقارنة بالحركي:','أكبر','أصغر','مساوياً دائمًا','سالبًا','لذلك يصعب بدء الحركة أكثر من إبقائها.'],
['ph:13','معامل الاحتكاك:','لا وحدة له','يقاس بالنيوتن','يقاس بالكيلوغرام','يقاس بالمتر','لأنه نسبة بين قوتين.'],
['ph:13','صندوق كتلته 25.0 kg يُدفع بسرعة منتظمة على أرضية معامل احتكاكها 0.20 فقوة الدفع تقارب:','49 N','245 N','5 N','25 N','F = μ mg = 0.20×25.0×9.8.'],
