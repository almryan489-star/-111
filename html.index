['ph:15','زمن تحليق الكرة السابقة عند عودتها للمستوى نفسه يقارب:','0.84 s','0.42 s','4.2 s','8.4 s','ضعف زمن الصعود.'],
['ph:15','أقصى ارتفاع للكرة السابقة يقارب:','0.86 m','4.1 m','0.42 m','8.6 m','h = v_yi²/(2g) = 16.8/19.6.'],
